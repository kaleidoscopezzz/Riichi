# Local development only. Copy this file to .env, then generate SECRET_KEY:
# .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(64))"
# Paste the generated value after SECRET_KEY= in the ignored .env file.
DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DATABASE_URL=sqlite:///db.sqlite3
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production: use config.settings.production, DEBUG=False, explicit public hosts,
# HTTPS origins and a secret PostgreSQL URL, supplied by the deployment environment.
# DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/riichi
