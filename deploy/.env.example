# Copy to deploy/.env (chmod 600). Never source this file as a shell script.
COMPOSE_PROJECT_NAME=riichi
RIICHI_VERSION=local
# Single real DNS name; no scheme/path/port. Owner must supply it.
SERVER_NAME=
# Exact browser origin: https://SERVER_NAME, plus :HTTPS_PORT when that is not 443.
CSRF_TRUSTED_ORIGINS=
SECRET_KEY=
POSTGRES_DB=riichi
POSTGRES_USER=riichi
POSTGRES_PASSWORD=
POSTGRES_ADMIN_USER=riichi_admin
POSTGRES_ADMIN_PASSWORD=
# Caddy is the only public listener. Production uses ports 80 and 443.
PUBLIC_BIND_IP=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
CADDY_CONFIG=Caddyfile
# Do not select QA configuration for a production deployment.
ACME_CA=https://acme-v02.api.letsencrypt.org/directory
# Dedicated internal proxy network; preflight must reject subnet conflicts.
PROXY_SUBNET=172.30.80.0/28
CADDY_PROXY_IP=172.30.80.2
HSTS_SECONDS=0
SESSION_COOKIE_AGE=28800
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=60
DB_MAX_CONNECTIONS=40
DB_SHARED_BUFFERS=256MB
API_MEMORY_LIMIT=768m
DB_MEMORY_LIMIT=1g
NGINX_MEMORY_LIMIT=128m
CADDY_MEMORY_LIMIT=256m
API_CPUS=1.0
DB_CPUS=1.0
NGINX_CPUS=0.5
CADDY_CPUS=0.5
