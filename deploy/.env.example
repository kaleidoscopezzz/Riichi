# Copy to deploy/.env (chmod 600). Never source this file as a shell script.
COMPOSE_PROJECT_NAME=riichi
RIICHI_VERSION=local
# Single real DNS name; no scheme/path/port. Owner must supply it.
SERVER_NAME=
CSRF_TRUSTED_ORIGINS=
SECRET_KEY=
POSTGRES_DB=riichi
POSTGRES_USER=riichi
POSTGRES_PASSWORD=
POSTGRES_ADMIN_USER=riichi_admin
POSTGRES_ADMIN_PASSWORD=
# Absolute HOST path, containing fullchain.pem and privkey.pem, readable by 101.
TLS_CERT_DIR=
PUBLIC_BIND_IP=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
HSTS_SECONDS=0
SESSION_COOKIE_AGE=28800
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=60
DB_MAX_CONNECTIONS=40
DB_SHARED_BUFFERS=256MB
API_MEMORY_LIMIT=768m
DB_MEMORY_LIMIT=1g
NGINX_MEMORY_LIMIT=128m
API_CPUS=1.0
DB_CPUS=1.0
NGINX_CPUS=0.5
